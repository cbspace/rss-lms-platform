// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "app/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Channel {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  posts       Post[]
}

model Post {
  id          String    @id @default(uuid())
  postNumber  Int       @unique @default(autoincrement())
  title       String
  author      String
  date        DateTime  @default(now())
  summary     String
  content     String
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  channels    Channel[]
}

model TelemetrySpan {
  id           String    @id @default(uuid())
  traceId      String
  name         String    // e.g. "GET /api/rss/[slug]"
  route        String    // e.g. "/api/rss/cs101"
  method       String    // GET, POST, PUT, DELETE
  statusCode   Int       // 200, 201, 404, 500
  durationMs   Int       // Execution duration in milliseconds
  clientIp     String
  feedSlug     String?
  postCount    Int?
  
  // Observability & error fields
  errorType    String?   // NOT_FOUND, EMPTY_FEED, DB_ERROR, VALIDATION_ERROR
  errorMessage String?
  
  timestamp    DateTime  @default(now())

  @@index([timestamp(sort: Desc)])
  @@index([feedSlug])
  @@index([clientIp])
  @@index([statusCode])
}