# Use Node LTS base image
FROM node:lts

# Create app directory and set initial ownership
WORKDIR /app
RUN chown node:node /app

# Switch to unprivileged 'node' user early
USER node

# Copy dependency manifests with native ownership
COPY --chown=node:node package*.json ./

# Install dependencies as 'node' user (node_modules natively owned by node)
RUN npm install

# Copy configuration scripts and schema
COPY --chown=node:node wait-for-it.sh entrypoint-dev.sh ./
COPY --chown=node:node prisma ./prisma/

# Grant execution permissions to entrypoint scripts
USER root
RUN chmod +x /app/wait-for-it.sh /app/entrypoint-dev.sh
USER node

# Copy remaining application source code
COPY --chown=node:node . .

# Expose Next.js server port
EXPOSE 3000

# Hand off execution to the dev entrypoint script
ENTRYPOINT ["/app/entrypoint-dev.sh"]